# Cogitator — DMbot (the DM brain). Copy this file to `.env` and fill in the values.
# NEVER commit `.env` (it is gitignored). Bot A lives in the separate music bot repo and
# has its own token there — only DMbot's token belongs here.
#
# This template runs EVERYTHING on the GPU: whisper (STT) and XTTS (TTS) on `cuda`, with Ollama
# on the GPU as its own process. On a 16 GB card (RTX 5080) that all fits comfortably. On a 12 GB
# card (RTX 4070) the LLM + whisper-fp16 + XTTS trio can tip VRAM over — XTTS's forward pass then
# hits a runtime CUDA assert that poisons the whole process (STT dies too; seen live 2026-06-13).
# If that happens on a small card, set TTS_DEVICE=cpu (and/or WHISPER_DEVICE=cpu + WHISPER_COMPUTE=
# int8), or offload Ollama to another box via OLLAMA_HOST (Tailscale, ADR 002).

# --- Discord: DMbot only ---
# DMbot's bot token (REQUIRED) from the Discord developer portal. Stays EMPTY in this committed
# template on purpose — put the real token only in your local `.env`, never in git.
DISCORD_TOKEN_DMBOT=

# --- Ollama (LLM host + model) ---
# Dev/MVP: local on the dev box. Later optionally only Ollama on the 5080 via Tailscale (ADR 002).
# Switching the host MUST be this one line — never hardcode it in code. `ollama serve` must be up
# and the models pulled (`ollama pull mistral-nemo`, `ollama pull bge-m3`).
OLLAMA_HOST=http://127.0.0.1:11434
# DM model. mistral-nemo won the Phase-0 taste test (idiomatic German). gemma3:12b was live-tested
# but didn't fix the dice-marker problem (that's a separate roll-detection step, not the model).
OLLAMA_MODEL=mistral-nemo
# LLM context window (Ollama num_ctx). High by default now that a 16 GB GPU runs it — 8k silently
# truncated the prompt head (persona + adventure) mid-session. Lower it if VRAM gets tight.
OLLAMA_NUM_CTX=24576
# NOT read by DMbot — set it on the OLLAMA SERVER (environment of the ollama service), because
# since D107 a turn fires TWO short side calls in one asyncio.gather (scene + fact classifier,
# ADR 057/058). With OLLAMA_NUM_PARALLEL=1 the server serialises them while both timeouts run
# from the same moment, so the second one silently times out instead of answering. Use >= 2.
#   PowerShell:  setx OLLAMA_NUM_PARALLEL 2   (then restart ollama)
# Anti-repetition sampling (ADR 042). nemo with no penalty (the old default) loops / drifts into
# generic filler on a 12B model; a mild penalty curbs it before the post-hoc echo guard has to.
# 1.1 is gentle (too high frays German / blocks legit re-use of a name); repeat_last_n is the
# look-back window. Rides on every narration call; the deterministic roll router neutralises it.
# Tune by ear (1.0 = off).
DM_REPEAT_PENALTY=1.1
DM_REPEAT_LAST_N=256

# --- DM turn shaping ---
# Hard cap on a normal DM turn's length (~tokens) — the deterministic ceiling against monologues.
# ~220 ≈ 2–4 atmospheric sentences. A capped turn is trimmed to its last complete sentence.
DM_NUM_PREDICT=220
# Length budget for the one-time !intro opening monologue (ADR 031) — larger than a normal turn so
# the opener can cover place + mission + how the party arrived AND a personal beat per character.
# `!intro test` reads the same text out sentence-by-sentence (punctuation stripped, XTTS babbles on
# punctuation). One-off command, so a generous value is safe; tune by ear.
DM_INTRO_NUM_PREDICT=800
# Sampling temperature for the !intro opening monologue only (D83/D84 / ADR 041). 0.5 steadied the
# brief-following but read flat/formulaic; with the meta-open + quote-wrap now stripped
# deterministically (sanitize.py), 0.7 gives the richer atmospheric weaving the table liked without
# the meta-tic leaking through. Tune by ear: toward 0.8 = more flair, 0.3 = flatter. (Normal turns
# are unaffected — model default.)
DM_INTRO_TEMPERATURE=0.7
# Max buffered player lines a !dm turn sends to the LLM. Without a wake word, transcription piles up
# table talk between turns; only the most recent N are kept. 0 = unbounded; lower = tighter focus.
DM_MAX_LINES=8
# Active system profile (Phase 8): which data/systems/<name>.json the dice engine applies. IM is the
# first hand-written profile (1d100 roll-under, success levels). Other systems are other profiles.
DM_SYSTEM=imperium_maledictum
# Active adventure compendium (Phase 10a, ADR 019): which data/adventures/<name>/ scene cards +
# NPC statblocks the DM runs (German, authored offline from the bought PDF — local-only, not in git).
# `!ort <id>` moves the scene pointer, `!szenen` lists them. Empty = no adventure. Rule questions
# additionally use the rulebook RAG store if data/vectordb/rag.db exists — build it once with:
#   uv run python -m dmbot.rag.ingest "data/pdfs/md/<rulebook>.md" --source rulebook
# (embedding model bge-m3 — `ollama pull bge-m3` first; multilingual, German questions hit English text).
DM_ADVENTURE=chemical_burn
# Default party (D82 / ADR 040): the party loaded for a voice channel that has no own
# data/sessions/<id>/characters.json — names a data/sessions/<name>/ whose characters.json is the
# fallback. The committed "_default" party (data/sessions/_default/characters.json) ships in git, so
# a teammate's clone AND every new/other voice channel load the real party instead of the generic
# _example one (the party is no longer bound to one channel id). Set empty to fall back to _example.
DM_DEFAULT_PARTY=_default

# --- DM behaviour toggles ---
# Roll-detection router (ADR 014): after narration, a separate constrained-JSON call classifies the
# player's action → which test (skill + difficulty) and posts the 🎲 button — far more reliable than
# the model's inline <<TEST>> marker (kept as fallback). ON by default; 0 disables.
DM_ROLL_ROUTER=1
# Streaming pipeline (ADR 017): stream the answer and speak it sentence-by-sentence, so the first
# audio plays while the rest generates. ON by default; 0 = byte-identical batch path. Needs a TTS
# backend (text-only runs ignore it).
DM_STREAMING=1
# Per-turn conversation autosave (D41): append every completed DM turn to data/sessions/<id>/
# history.jsonl so a crash doesn't lose the evening's thread; restored on !join, rotated on !leave.
# World state persists separately (ADR 015). ON by default; 0 disables.
DM_AUTOSAVE=1
# Rolling auto-recap / context handoff (D57/ADR 027): when a turn's prompt nears OLLAMA_NUM_CTX, then
# AFTER it's spoken (off the hot path), summarise the running history into a cumulative recap, persist
# it like !wrap up, and clear the in-memory history — so the prompt head (persona + adventure) is
# never silently truncated mid-session. ON by default; 0 falls back to a bare budget warning.
DM_AUTORECAP=1
# Auto scene transitions (D56/ADR 026): the DM emits <<ORT id>>, code validates it and a human
# confirms via a button before the pointer moves. "verbunden" = only the current scene's leads_to
# neighbours; "frei" = any known scene id. Switchable live with !ortmodus. Unknown value → verbunden.
DM_SCENE_MODE=verbunden
# Stateful scene cards (ADR 043): the DM flags a scene element (Gelegenheit/Geheimnis) done via
# <<ERLEDIGT id>>; code validates the id against the CURRENT scene card and (default) posts a
# confirm button before the flag is applied. 0 = apply valid flags immediately, no button.
# Manual override anytime: !erledigt <id> / !offen <id>.
# The same knob gates consequence-clock ticks (<<UHR id>>, ADR 047): 1 = confirm button per
# proposed tick, 0 = apply valid ticks (max +1 per clock per turn) immediately.
# Clocks themselves are human-made: !uhr neu "<Name>" <4|6|8>, !uhr tick/zurück/weg, !uhren.
# It also gates <<ZEIT +…>> time-advance proposals (ADR 048; first valid marker per turn,
# clamped to +12h). Time/deadline commands: !zeit [+6h|tag], !frist neu/weg, !fristen.
DM_FLAG_CONFIRM=1
# In-game time (ADR 048): minutes that pass automatically on a real scene change (!ort or a
# confirmed <<ORT>> move) — travel/regrouping. 0 disables the automatic advance.
DM_SCENE_TIME_ADVANCE=30
# NPC memory (ADR 044): at a scene change (and !wrap up) one extra LLM call extracts what the
# scene's NPCs would remember — incl. what players told/promised/LIED to them; code clamps any
# attitude drift to ±1 step per scene and spreads important news as faction hearsay. The block is
# injected while the NPC is in the scene. Off the hot path (no per-turn latency). 0 disables —
# which also disables NPC agendas (ADR 049) and the Chekhov-list extraction at !wrap (ADR 050);
# both ride inside this call.
DM_NPC_MEMORY=1
# How many memories per scene NPC ride in the prompt (revealed lies always included on top;
# rest ranked importance, then recency). Higher = more colour, more prompt tokens.
DM_NPC_MEMORY_TOP_K=6
# Consistency guard (ADR 045): before a batch-path answer is posted/spoken, a deterministic
# code check (no LLM judge) verifies it against the world state — a dead NPC or a named NPC
# not in the current scene must not get speech attributed. On a violation the answer is
# regenerated ONCE with a concrete German correction; a still-failing retry is delivered
# anyway (the guard never blocks the session). The streaming path can only log (the audio has
# already played) — see ADR 045. 0 disables the whole guard.
DM_CONSISTENCY_GUARD=1

# --- The post-turn machinery (D107 / ADR 057, 058, 059) ---
# Everything below runs AFTER a turn has been narrated, while the DM is still speaking, so it
# costs the table no waiting. Each block is switchable on its own — at the table with
# `!automatik <name> an|aus`, here as the default — because on 2026-08-22 one dead mechanism
# (the <<ORT>> marker, zero hits in 22 turns) took the whole evening with it.
#
# Scene-move classifier (ADR 057 #1): one constrained-JSON call per turn asking whether the
# group actually ENTERED one of the current scene's reachable exits. Same call shape as the roll
# router. 0 leaves the inline <<ORT>> marker as the only mover again.
DM_SCENE_ROUTER=1
# Flag gate (ADR 057 #2): a scene whose opportunities are ALL resolved and that has exactly one
# open exit advances with no LLM involved at all. 0 disables the model-free push.
DM_SCENE_FLAG_GATE=1
# How long the ↩ "Zurücknehmen" control under an automatic scene change stays live, in seconds
# (ADR 057 #4). The change happens immediately; this is the recovery. 0 = announce without it.
DM_SCENE_UNDO_SECONDS=60
# Fact classifier (ADR 058): a second call on the same turn boundary (one latency window) that
# turns a narrated commitment — an item handed over, a quest accepted, a promise given — into a
# hard world-state fact, validated by code before anything is written. 0 disables it.
DM_FACT_ROUTER=1
# In-game minutes each narrated turn costs (ADR 059 #2). Small on purpose: the clock only has to
# MOVE — it stood at 08:00 for a whole evening played before midnight. The bigger scene-change
# advance is DM_SCENE_TIME_ADVANCE above; <<ZEIT>> still carries deliberate jumps. 0 = off.
DM_TURN_TIME_ADVANCE=2
# Cadence of a scene's standing GM guidance in the prompt: injected on the first turn in a scene
# and every Nth turn after, as an impulse instead of a standing order (that is what made one NPC
# repeat the deadline line in eight of ten answers). 1 = every turn (pre-D107), 0 = never.
DM_GUIDANCE_EVERY=4
# Player panel (PRD stories 14-17): one message in the game channel — where you are, what you
# want, what time it is, how long you have, whose turn it is, what is still open here — edited in
# place and re-anchored at the bottom after every turn. In players' language, no gate codes and
# no command lines: those stay in the 🧪 overlay below, which belongs in DM_DEBUG_CHANNEL when
# both are on. 0 removes the panel.
DM_PLAYER_PANEL=1

# 🧪 Debug overlay (ADR 052): if the loaded adventure ships a testplan.json sidecar, every
# scene change posts/edits ONE compact OOC line (scene, gates under test, hint) — pure
# deterministic Discord output, zero LLM calls, zero prompt bytes; the DM never sees it.
# Dormant without the sidecar. 0 disables it entirely.
DM_DEBUG_OVERLAY=1
# Optional: a channel id for OOC operator output (keeps test chatter out of play). The 🧪 overlay
# falls back to the game channel when this is unset; the D107 rejected-scene-change line does NOT
# — without a channel here it only reaches the log, on purpose, because it names a scene id the
# players have not reached yet. Set it for a debug evening. An unresolvable id logs once.
DM_DEBUG_CHANNEL=

# --- Bot A bridge (the music bot's HTTP endpoint: GET /health, blocking POST /speak) ---
# Localhost (default): both bots on the SAME machine; DMbot sends the WAV *path* (shared disk).
# Cross-machine: point DM_BRIDGE_HOST at Bot A's Tailscale/LAN IP — DMbot then sends the WAV *bytes*
# and Bot A plays its own copy (ADR 010). No code change, just the host value.
DM_BRIDGE_HOST=127.0.0.1
DM_BRIDGE_PORT=8765
# Shared secret, required only off-loopback (bytes mode). Set the SAME value here and in the music
# bot's .env. Leave empty for localhost path mode (no secret needed).
DM_BRIDGE_SECRET=

# --- Feedback protection: layer 1 (mandatory, golden rule #4) ---
# Bot A's Discord user-ID — the voice sink drops this user's audio so DMbot never transcribes its own
# DM voice. Even unset, any bot in the channel is dropped via its bot-flag; setting the ID is exact.
BOT_A_USER_ID=1361375360784273409

# --- STT (faster-whisper, Phase 4) — ON THE GPU ---
# Model size: tiny / base / small / medium / large-v3. Bigger = more accurate but slower + more VRAM
# (small ~1 GB, medium ~2.5 GB on GPU). medium won the live German test.
WHISPER_MODEL=medium
# GPU (cuda / float16): ~5–8× faster per clip than CPU/int8, which kept STT minutes behind in
# continuous play. Auto-falls back to CPU int8 if CUDA init fails. On a tight 12 GB card drop to
# cpu / int8 here to free VRAM for XTTS.
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

# --- Turn-taking (Phase 7) ---
# Push-to-talk: the whole table is always transcribed + logged (full record), but only speech said
# while the Discord mic button is engaged is routed to the DM — one tap for everyone. 0 = route all.
DM_PUSH_TO_TALK=1
# Releasing the mic button auto-runs the DM turn (no separate !dm). It first waits for the just-said
# speech to finish transcribing. 0 = manual !dm flow.
DM_BUTTON_AUTOSEND=1
# Feedback layer 2 (opt-in): pause the VAD while Bot A speaks. OFF by default so the table keeps
# being transcribed during narration; layer 1 already drops the DM's own voice. 1 = pause (mic bleed).
DM_PAUSE_VAD_WHILE_SPEAKING=0

# --- TTS (Phase 6): XTTS v2, speaker Dionisio Schuyler — ON THE GPU ---
# Backend: "xtts" (Coqui XTTS v2, ~58 built-in speakers, voice-cloning-capable — the default) or
# "piper" (fast, fixed German voice, the lean fallback if XTTS won't load).
TTS_ENGINE=xtts
# Piper voice .onnx; empty → default voices/de_DE-thorsten-medium.onnx (.onnx.json next to it).
PIPER_VOICE=
# XTTS speaker (only with TTS_ENGINE=xtts); empty → Dionisio Schuyler. List: voices/samples/
# _speakers.txt, or !voices in Discord. Switch live with !voice <Name>.
TTS_SPEAKER=
# XTTS device: "cuda" (near real-time, needs the CUDA torch build + free VRAM) or "cpu" (~1.5× real
# time, safe). cuda auto-falls back to cpu at LOAD time, but a *runtime* OOM on a tight card crashes
# the process — see the VRAM note at the top. On a 16 GB card keep cuda.
TTS_DEVICE=cuda
# XTTS anti-loop sampling (D55): repetition_penalty for the GPT decoder. 10.0 = XTTS's own strong
# anti-babble default (the model config ships the weaker 5.0). Raise further if XTTS still loops on a
# phrase. (`!intro test` additionally strips punctuation, which XTTS tends to babble on.)
XTTS_REPETITION_PENALTY=10.0

# --- Debug / logging ---
# Dump each utterance as a WAV to the OS temp dir. Off by default (fills the disk); 1 to inspect a clip.
DM_DUMP_UTTERANCES=0
# Root log level for DMbot (DEBUG / INFO / WARNING / ERROR). Default INFO.
LOG_LEVEL=INFO
# Debug file logs. 1 records the run as TWO pasteable files: logs/terminal.log (console mirror,
# reset on every start) and logs/debug.log (fuller detail + tracebacks, PCM flood collapsed, appended).
# Code default is off (console stays lean); enabled here so a run is captured by default. 0 to disable.
DM_LOG_FILE=1
# Clean session transcript (logs/transcript.log): just the conversation (player lines + DM answers)
# with timestamps, incl. table talk — pasteable as a record. Separate from DM_LOG_FILE. On by default.
DM_TRANSCRIPT_FILE=1
