# Cogitator — DMbot (the DM brain). Copy this file to `.env` and fill in the values.
# NEVER commit `.env` (it is gitignored). Bot A lives in the separate music bot repo and
# has its own token there — only DMbot's token belongs here.

# --- Discord: DMbot only ---
DISCORD_TOKEN_DMBOT=

# --- Ollama (LLM host + model) ---
# Dev/MVP: local on Tobi's 4070. Later optionally only Ollama on the 5080 via Tailscale
# (ADR 002). Switching the host MUST be this one line — never hardcode it in code.
OLLAMA_HOST=http://127.0.0.1:11434
# DM model. mistral-nemo won the Phase-0 taste test (idiomatic German); gemma3:12b is the
# atmospheric runner-up worth re-checking with the real persona prompt.
OLLAMA_MODEL=mistral-nemo
# LLM-Kontextfenster (Ollama num_ctx). Hoch per Default, seit die 16 GB 4080 läuft; bei knappem
# VRAM senken (XTTS + Whisper teilen sich die GPU).
OLLAMA_NUM_CTX=24576
# Hard cap on a DM turn's length (~tokens) — the deterministic ceiling against monologues.
# ~220 ≈ 2–4 atmospheric sentences (the praised sessions ran here; the 160 squeeze predates
# streaming, which plays the first sentence while the rest generates). A capped turn is trimmed
# to its last complete sentence so it never ends mid-word.
DM_NUM_PREDICT=220
# Max buffered player lines a !dm turn sends to the LLM. Without a wake word, transcription piles
# up table talk + jokes between turns; sending the whole pile drowns the real action, so only the
# most recent N are kept. 0 = unbounded; lower = tighter focus on the latest intent.
DM_MAX_LINES=8
# Active system profile (Phase 8): which data/systems/<name>.json the dice engine applies. IM is the
# first hand-written profile (1d100 roll-under, success levels). Other systems are other profiles.
DM_SYSTEM=imperium_maledictum
# Active adventure compendium (Phase 10a, ADR 019): which data/adventures/<name>/ scene cards +
# NPC statblocks the DM runs (German, authored offline from the bought PDF — local-only content,
# not in git, like the PDFs). The scene pointer is `!ort <id>`; `!szenen` lists them. Empty = no
# adventure. Rule questions additionally use the rulebook RAG store if data/vectordb/rag.db
# exists — build it once with:
#   uv run python -m dmbot.rag.ingest "data/pdfs/md/<rulebook>.md" --source rulebook
# (embedding model bge-m3 — `ollama pull bge-m3` first; multilingual, German questions hit
# English rule text).
DM_ADVENTURE=chemical_burn
# Roll-detection router (ADR 014): after the narration turn, a separate constrained-JSON call
# classifies the player's action → which test (skill + difficulty) and posts the dice button —
# far more reliable than the model's inline <<TEST>> marker (which stays as a fallback). Costs one
# extra short LLM call per turn. ON by default (validated live); set DM_ROLL_ROUTER=0 to disable.
# The classifier now fires at generation-end and posts the 🎲 button while the DM still speaks (D40).
DM_ROLL_ROUTER=1
# Streaming pipeline (ADR 017): stream the LLM answer and speak it sentence-by-sentence, so the
# first audio plays while the rest is still generating — time-to-first-audio drops from "whole
# generation + whole synthesis" to "first sentence". ON by default; DM_STREAMING=0 = the
# byte-identical batch path (one WAV per turn). Needs a TTS backend (text-only runs ignore it).
DM_STREAMING=1
# Per-turn conversation autosave (D41): append every completed DM turn to
# data/sessions/<id>/history.jsonl (append-only) so a crash doesn't lose the evening's conversation
# thread; restored on !join (into an empty history), rotated to history.<timestamp>.jsonl on !leave.
# World state persists separately (ADR 015). ON by default; DM_AUTOSAVE=0 disables it.
DM_AUTOSAVE=1

# --- Bot A bridge (the music bot's HTTP endpoint: GET /health, blocking POST /speak) ---
# Localhost (default): both bots on the SAME machine; DMbot sends the WAV *path* (shared disk).
# Cross-machine: point DM_BRIDGE_HOST at Bot A's Tailscale/LAN IP — DMbot then sends the WAV
# *bytes* and Bot A plays its own copy (ADR 010). No code change, just the host value.
DM_BRIDGE_HOST=127.0.0.1
DM_BRIDGE_PORT=8765
# Shared secret, required only off-loopback (bytes mode). Set the SAME value here and in the
# music bot's .env. Leave empty for localhost path mode (no secret needed).
DM_BRIDGE_SECRET=

# --- Feedback protection: layer 1 (mandatory) ---
# Bot A's Discord user-ID. The voice sink drops this user's audio so DMbot never
# transcribes its own DM voice. Optional but recommended: even unset, any bot in the
# channel is dropped via its bot-flag — setting the ID makes the filter exact.
BOT_A_USER_ID=

# --- STT (faster-whisper, Phase 4) ---
# Model size: tiny / base / small / medium / large-v3. Bigger = more accurate but slower and
# more VRAM (small ~1 GB, medium ~2.5 GB on GPU). Default medium (won the live German test).
WHISPER_MODEL=medium
# Device + compute. See the two GPU profiles below.
#   4070 dev (12 GB): cpu / int8   — frees VRAM so XTTS fits on the GPU next to nemo.
#   5080 (16 GB):     cuda / float16 — room for everything on the GPU.
# Auto-falls back to CPU int8 if CUDA init fails either way.
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

# --- Turn-taking (Phase 7) ---
# Push-to-talk: the whole table is always transcribed + logged (full record, handy for recaps),
# but only speech said while the Discord mic button is engaged is routed to the DM. Tap the button
# before talking to the DM, tap again when done — one tap for everyone. 0 = route everything (legacy).
DM_PUSH_TO_TALK=1
# Releasing the mic button auto-runs the DM turn (no separate !dm needed). It waits for the just-said
# speech to finish transcribing first, so the last line isn't pushed into the next turn. 0 = manual !dm.
DM_BUTTON_AUTOSEND=1
# Feedback layer 2 (opt-in): pause the VAD while Bot A (the DM voice) speaks. OFF by default so the
# table keeps being transcribed during the narration (full record). Layer 1 (the Bot-A user-ID
# filter) always drops the DM's own voice regardless. Set to 1 to pause (e.g. if mic-to-speaker
# bleed gets transcribed as a player during narration).
DM_PAUSE_VAD_WHILE_SPEAKING=0

# --- TTS (Phase 6) ---
# Backend: "piper" (fast, fixed German voice) or "xtts" (Coqui XTTS v2, ~58 built-in
# speakers, voice-cloning-capable, heavier/slower — pulls torch).
TTS_ENGINE=xtts
# Piper voice .onnx; empty → default voices/de_DE-thorsten-medium.onnx (.onnx.json next to it).
PIPER_VOICE=
# XTTS speaker (only with TTS_ENGINE=xtts); empty → Dionisio Schuyler. List: voices/samples/
# _speakers.txt, or !voices in Discord. Switch live with !voice <Name>.
TTS_SPEAKER=
# XTTS device: "cuda" (near real-time, needs the CUDA torch build + free VRAM) or "cpu"
# (~1.5x realtime). cuda auto-falls back to cpu if torch has no CUDA or the GPU OOMs.
TTS_DEVICE=cuda

# === Per-machine GPU profiles (same code, only these env vars differ) =========================
#   4070 dev/debug (12 GB):  WHISPER_DEVICE=cpu   WHISPER_COMPUTE=int8     TTS_DEVICE=cuda
#                            (whisper on CPU frees VRAM for XTTS; optionally OLLAMA_HOST → 5080)
#   5080 full-GPU  (16 GB):  WHISPER_DEVICE=cuda  WHISPER_COMPUTE=float16  TTS_DEVICE=cuda
# Both need the CUDA torch build (pyproject pulls torch/torchaudio/torchcodec from the cu130
# index — CUDA 13.0, covers RTX 40xx Ada + 50xx Blackwell). A box without a usable NVIDIA GPU
# degrades to CPU automatically.
# =============================================================================================
# Debug only: dump each utterance as a WAV to the OS temp dir. Off by default (it fills up
# the disk). Set to 1 to inspect a clip, e.g. when a transcript looks wrong.
DM_DUMP_UTTERANCES=0

# --- Logging ---
# Root log level for DMbot (DEBUG / INFO / WARNING / ERROR). Default INFO.
LOG_LEVEL=INFO
# Debug file logs — OFF by default (console stays lean, nothing written to disk). Set to 1 to record
# a run as TWO pasteable files: logs/terminal.log (plain mirror of the console) and logs/debug.log
# (fuller detail + tracebacks, with the PCM heartbeat flood collapsed so it stays token-light).
DM_LOG_FILE=0
# Clean session transcript (logs/transcript.log): just the conversation — player lines + DM answers
# with timestamps, incl. table talk, none of the debug chatter. Pasteable as a record of a session.
# Separate from DM_LOG_FILE (that one is the detailed debug log). On by default; 0 to disable.
DM_TRANSCRIPT_FILE=1
