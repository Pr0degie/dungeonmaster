# Secrets — never commit (CLAUDE.md golden rule: two processes, two tokens)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Tooling caches (pytest for rules/, optional linters/type-checkers)
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Note: uv.lock is intentionally NOT ignored — commit it for reproducible installs.

# Audio temp — Piper output / Bot A WAVs (Windows OS temp dir, never /tmp)
*.wav

# Piper voice models — large binaries, downloaded per SETUP.md B5 (not committed)
voices/

# Logs (pipeline PCM/transcript/debug logs)
*.log

# Generated data — system profiles, PDFs, session state, vector store (not hand-edited).
# Ignore the contents, but keep the directory skeleton via .gitkeep so a fresh clone has
# the structure to write into.
data/**
!data/
!data/systems/
!data/pdfs/
!data/sessions/
!data/vectordb/
!data/**/.gitkeep

# Agent / editor / OS cruft
.claude/**
.vscode/
.idea/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
