#!/usr/bin/env bash
# git pre-commit hook — gate commits that touch code, tests or profiles with `uv run dm-check`
# (ruff F + test suite + dm-eval, dmbot/tools/dm_check.py). BLOCKING: a red check aborts the commit.
# Bypass a deliberate partial commit with `git commit --no-verify`.
#
# Installed via `git config core.hooksPath tools/hooks` (this tracked script IS the hook — no copy
# in .git/hooks that could drift). On a fresh clone run that one command once. Runs under Git for
# Windows' bash.
#
# 1. Scope guard: only when STAGED changes touch dmbot/ tests/ data/systems/ — a docs-only commit
#    passes straight through.
# 2. Stamp: a green dm-check remembers the git tree hash of those three paths in .dm-check.stamp
#    (git-ignored). If it still matches the WORKING TREE (`dm-check --fresh`), the commit passes
#    without re-running anything. Any edit, deletion or new untracked file under the three paths
#    changes the hash; a red run leaves no stamp; a missing or unreadable stamp means "run".
# 3. Otherwise: full dm-check against the working tree (not a stashed staged snapshot — keep the
#    tree clean at commit time, or use --no-verify).
set -uo pipefail

staged="$(git diff --cached --name-only -- dmbot tests data/systems 2>/dev/null || true)"
[ -z "$staged" ] && exit 0

if uv run --quiet python -m dmbot.tools.dm_check --fresh >/dev/null 2>&1; then
  echo "[pre-commit] dm-check stamp matches the working tree -> no re-run."
  exit 0
fi

echo "[pre-commit] code/tests/profiles staged, no matching dm-check stamp -> uv run dm-check (bypass: git commit --no-verify) ..."
if ! uv run dm-check; then
  echo "[pre-commit] commit aborted (bypass once with: git commit --no-verify)." >&2
  exit 1
fi
echo "[pre-commit] green."
exit 0
